name: Approve

# Thin launcher for the coding-factory `/approve` gate. A reviewer approves a
# plan by commenting `/approve` on its draft PR (see the Inner Plan runbook).
# This workflow does NO build work — it only launches the Scrum Master and exits.
# It launches the Scrum Master (NOT Build directly): the SM records the plan's
# `Status: approved`, spawns Build as an *awaited* subagent, reads its structured
# result, and judges it (proceed / escalate / re-plan). This launcher never
# merges — red tests must not reach main.

on:
  issue_comment:
    types: [created]

# Least privilege: the launcher only launches the agent. The Scrum Master does
# its own repo/issue/PR writes via the GitHub MCP server (GITHUB_MCP_TOKEN).
permissions:
  contents: read

jobs:
  approve:
    name: Launch Scrum Master
    # Fire only for a top-level PR-conversation comment whose body is exactly
    # `/approve`, from an authorized commenter. This ignores inline review
    # comments on diff lines (they are not issue_comment events), comments on
    # non-PR issues, any other text, and unauthorized users. The guard is a
    # bare Actions expression with no interpolation delimiters, so the Jinja
    # render leaves it untouched (no raw-wrapping needed).
    if: >
      github.event.issue.pull_request &&
      github.event.comment.body == '/approve' &&
      contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'), github.event.comment.author_association)
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Launch Scrum Master managed agent (approve event)
        env:
          # Passed via env (never interpolated into the run: script) to avoid
          # shell-injection from event context.
          ANTHROPIC_API_KEY: {% raw %}${{ secrets.ANTHROPIC_API_KEY }}{% endraw %}
          GITHUB_MCP_TOKEN: {% raw %}${{ secrets.GITHUB_MCP_TOKEN }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
          PR: {% raw %}${{ github.event.issue.number }}{% endraw %}
        run: |
          # TODO(managed-agents-api): wire the launch call once the endpoint,
          # anthropic-beta header, and the mechanism that references the
          # Scrum Master agent spec (managed-agents/scrum-master.yml, uploaded to
          # the workspace) are pinned. The launch must:
          #   1. Create a Scrum Master managed-agent session for the approve event.
          #   2. Attach $REPO as a `github_repository` Resource (cloned at main),
          #      and supply $GITHUB_MCP_TOKEN as the agent's GitHub MCP server
          #      `authorization_token` (repo + issues write scope).
          #   3. Send the kickoff user.message below.
          #
          # Kickoff user.message (keep in sync with
          # _workflow/managed-agents/README.md):
          #   "Plan approved on PR #$PR in $REPO. Record Status: approved on that
          #    plan, spawn Build for its issue (awaited), then judge Build's
          #    structured result: proceed (Build flipped the draft PR to ready),
          #    escalate, or re-plan. Do not merge."
          echo "::error::Approve launcher is not wired to the managed-agents API yet. Implement the launch call in .github/workflows/approve.yml (see the TODO above) and set the ANTHROPIC_API_KEY and GITHUB_MCP_TOKEN repository secrets. Fails loudly by design so an unwired launcher is never mistaken for a working one."
          exit 1
