name: Scrum Master

# Thin launcher for the coding-factory Scrum Master orchestrator (a Claude
# Managed Agent). This workflow does NO build work — it only launches the Scrum
# Master and exits. The Scrum Master is resumable, not long-running: it wakes on
# this event, reconstructs state from durable repo artifacts (spec/spec.md
# Status, spec/build-order.md, live issue/PR state, subagents' returned JSON),
# takes the single next action, and exits. It is the sole thing that spawns and
# judges every subagent (Sequencing / Planner / Build) — none of those are ever
# launched by a GitHub Action.
#
# Fires on EVERY merge to main; the Scrum Master reconciles and acts only on
# merges it owns (approved-but-unsequenced spec -> Sequencing; last issue of a
# group merged -> next group's Planners; all merged -> Deliver-ready; anything
# else -> no-op). Planning is just-in-time: only the current ready group's
# Planners are launched, never the backlog.

on:
  push:
    branches: [main]
  # Manual re-reconcile from the Actions tab. Safe and idempotent: the Scrum
  # Master reconciles from current state regardless of what woke it, so a manual
  # run just takes whatever the next action is (or a no-op) — useful if a merge
  # event was missed or you want to force a reconcile against latest main.
  workflow_dispatch:

# Single-flight, coalescing: a burst of parallel-group merges collapses to one
# reconcile against the latest main instead of one run per merge.
concurrency:
  group: scrum-master
  cancel-in-progress: true

# Least privilege: the launcher itself needs nothing beyond reading the repo.
# The Scrum Master does its own repo/issue writes via the GitHub MCP server,
# authenticated with GITHUB_MCP_TOKEN (below), not the workflow's GITHUB_TOKEN.
permissions:
  contents: read

jobs:
  reconcile:
    name: Launch Scrum Master
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Launch Scrum Master managed agent (merge event)
        env:
          # Passed via env (never interpolated into the run: script) to avoid
          # shell-injection from event context.
          ANTHROPIC_API_KEY: {% raw %}${{ secrets.ANTHROPIC_API_KEY }}{% endraw %}
          GITHUB_MCP_TOKEN: {% raw %}${{ secrets.GITHUB_MCP_TOKEN }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
        run: |
          # TODO(managed-agents-api): wire the launch call once the endpoint,
          # anthropic-beta header, and the mechanism that references the
          # Scrum Master agent spec (managed-agents/scrum-master.yml, uploaded to
          # the workspace) are pinned. The launch must:
          #   1. Create a Scrum Master managed-agent session.
          #   2. Attach $REPO as a `github_repository` Resource (cloned at main),
          #      and supply $GITHUB_MCP_TOKEN as the agent's GitHub MCP server
          #      `authorization_token` (repo + issues write scope).
          #   3. Send the kickoff user.message below.
          #
          # Kickoff user.message (keep in sync with
          # _workflow/managed-agents/README.md):
          #   "Reconcile $REPO at main. If spec/spec.md is approved and
          #    spec/build-order.md is absent, spawn Sequencing (awaited), then
          #    launch the first ready group's Planners. Else advance groups:
          #    when a group's last issue is merged, launch the next group's
          #    Planners (JIT — the ready group only, never the backlog); when all
          #    issues are merged, mark Deliver-ready. Otherwise no-op. Do not use
          #    labels for control flow."
          echo "::error::Scrum Master launcher is not wired to the managed-agents API yet. Implement the launch call in .github/workflows/scrum-master.yml (see the TODO above) and set the ANTHROPIC_API_KEY and GITHUB_MCP_TOKEN repository secrets. Fails loudly by design so an unwired launcher is never mistaken for a working one."
          exit 1
